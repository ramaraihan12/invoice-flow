APP_NAME="Invoice Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invoice_flow
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# LLM used for extraction. Ollama is the default and needs no key.
# Other options: openai, gemini, anthropic (set the matching *_API_KEY below).
INVOICE_LLM_PROVIDER=ollama
INVOICE_LLM_MODEL=qwen3.5:9b
# true only if the model accepts images (needed for photo uploads)
INVOICE_LLM_VISION=false
INVOICE_LLM_TIMEOUT=300

OLLAMA_URL=http://localhost:11434
OLLAMA_THINK=false

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Approved invoices are POSTed here, signed with HMAC-SHA256 using the secret.
INVOICE_WEBHOOK_URL=
INVOICE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
